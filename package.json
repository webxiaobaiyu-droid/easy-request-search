{
  "name": "easy-request-search",
  "version": "0.1.0",
  "description": "Chrome DevTools panel for filtering network requests by URL, type, and parameters",
  "license": "MIT",
  "keywords": ["chrome-extension", "devtools", "network", "request-filter", "vue3"],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "package": "pnpm build && cd dist && zip -qrFS ../easy-request-search-v0.1.0.zip ."
  },
  "dependencies": {
    "lucide-vue-next": "0.468.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "vue-tsc": "2.2.12"
  },
  "packageManager": "pnpm@9.1.1"
}
